{
  "manifest_version": 3,
  "name": "Screen Limiter",
  "description": "Counts Chrome time in macOS Screen Time and closes sites that hit their limit.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabs", "nativeMessaging", "idle", "alarms"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Screen Limiter" }
}
